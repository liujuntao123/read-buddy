{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "read-buddy",
  "version": "0.1.0",
  "identifier": "com.readbuddy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "read-buddy",
        "width": 1200,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["epub", "mobi", "azw3", "fb2", "cbz"],
        "name": "Ebook",
        "description": "Electronic book (read-buddy)"
      }
    ]
  }
}
